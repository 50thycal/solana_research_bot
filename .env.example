# === Helius ===
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# === Database ===
DB_PATH=/data/research.db

# === Collect mode ===
TRACKING_DURATION_SECONDS=300         # How long to track each token (default: 5 minutes)
SNAPSHOT_INTERVAL_SECONDS=5           # Seconds between snapshots (configurable)
MAX_TX_SAMPLE_PER_SNAPSHOT=10         # Max transactions to sample per snapshot

# === Dashboard (always runs alongside collector) ===
PORT=3000                             # Dashboard web server port
